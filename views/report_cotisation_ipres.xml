        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arsata_payroll.livre_paie_template</field>
        <field name="report_file">arsata_payroll.livre_paie_template</field>
        <field name="paperformat_id" ref="arsata_payroll.paperformat_livre_paie"/>
    </record>
    
    
    
    
<template id="livre_paie_template">
<t t-call="web.html_container">
<t t-call="web.basic_layout">

<style>
    body {
        font-size: 11px;
        color: #000;
    }

    /* TITRE PRINCIPAL */
    h2 {
        text-align: center;
        font-size: 16px;
        margin-bottom: 6px;
        letter-spacing: 0.5px;
        color: #0B5394; 
        text-transform: uppercase;
    }

    .period {
        text-align: center;
        margin-bottom: 12px;
        font-weight: bold;
    }

    .matricule {
        font-weight: bold;
        margin: 10px 0 6px 0;
    }
    .year {
        text-align: center;
        font-weight: bold;
        color: #1f4ea3;
        margin-bottom: 6px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
    }

    
    thead th {
        background-color: #1C6DD0; /* ?? Bleu */
        color: #FFFFFF;
        border: 1px solid #000;
        padding: 5px 6px;
        font-weight: bold;
        text-align: left;
    }

    tbody td {
        border: 1px solid #000;
        padding: 4px 6px;
        vertical-align: top;
    }

    td.amount {
        text-align: right;
        white-space: nowrap;
    }
</style>


<div class="page">

    <!-- HEADER ENTREPRISE -->
    <table class="no-border">
        <tr>
            <td>
                <img t-if="company.logo"
                     t-att-src="'data:image/png;base64,' + company.logo.decode('utf-8')"
                     style="height:55px;"/><br/>
                <strong><t t-esc="company.name"/></strong><br/>
                <t t-esc="company.street or ''"/><br/>
                <t t-esc="company.city or ''"/><br/>
                <t t-esc="company.phone or ''"/>
            </td>
        </tr>
    </table>

    <h2>LIVRE DE PAIE ET CUMUL PAR MATRICULE ET PAR RUBRIQUE</h2>
    <div class="year">Annee <t t-esc="year"/></div>
    <div class="period">
        Periode du : <t t-esc="date_from"/> au <t t-esc="date_to"/>
    </div>

    <t t-foreach="employees.items()" t-as="emp_data">
        <t t-set="employee" t-value="emp_data[0]"/>
        <t t-set="lines" t-value="emp_data[1]"/>

        <div class="matricule">
            Matricule : <t t-esc="employee.registration_number or ''"/> 
            <t t-esc="employee.name"/>
        </div>
        <div class="period">
            Employe : 
            <t t-esc="employee.name"/>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width:15%;">Code</th>
                    <th style="width:65%;">Rubrique</th>
                    <th style="width:20%; text-align:right;">Cumul annuel</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="lines.items()" t-as="item">
                    <tr>
                        <td><t t-esc="item[0][0]"/></td>
                        <td><t t-esc="item[0][1]"/></td>
                        <td class="amount">
                            <t t-esc="('%.2f' % item[1])"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

        <div style="page-break-after:always;"></div>
    </t>

</div>

</t>
</t>
</template>

<record id="paperformat_css_paie" model="report.paperformat">
    <field name="name">CSS Portrait</field>
    <field name="default" eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>

    <field name="margin_top">10</field>
    <field name="margin_bottom">10</field>
    <field name="margin_left">10</field>
    <field name="margin_right">10</field>

    <field name="header_line" eval="False"/>
    <field name="header_spacing">5</field>
    <field name="dpi">90</field>
</record>



<record id="action_report_css_declaration" model="ir.actions.report">
    <field name="name">Declaration mensuelle de cotisations CSS</field>
    <field name="model">css.declaration.wizard</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">arsata_payroll.report_css_declaration</field>
    <field name="report_file">arsata_payroll.report_css_declaration</field>
    <field name="paperformat_id" ref="arsata_payroll.paperformat_css_paie"/>
</record>






<template id="report_css_declaration">
<t t-call="web.basic_layout">

<style>
.info-table {
    width: 100%;
    font-family: "Times New Roman", Times, serif;
    font-size: 13px;
    
    margin-top: 6px;
}
.info-table td {
    padding: 4px 6px;
    vertical-align: top;
}
.label {
    font-weight: bold;
}
.page {
    font-family: "Times New Roman", Times, serif;
    font-size: 13px;
    line-height: 1.4;
}
table {
    width: 100%;
    
    font-family: "Times New Roman", Times, serif;
    font-size: 13px;
}
th, td {
    border: 1px solid #000;
    padding: 6px;
}
th {
    background: #f0f0f0;
    font-weight: bold;
}
.text-right { text-align: right; }
.text-center { text-align: center; }
.img-full {
    width: 100%;
    display: block;
}
</style>

<main>
<div class="page">

<!-- ================= IMAGE HAUT ================= -->
<img t-att-src="'/arsata_payroll/static/description/declarationhaut.PNG'"
     class="img-full"/>

<p style="text-align:center; font-weight:bold; font-size:18px; margin:8px 0;">
DECLARATION MENSUELLE DE COTISATIONS
</p>
<table class="info-table">

    <!-- Ligne 1 -->
    <tr>
        <td>
            <span class="label">Site :</span>
            <t t-esc="site"/>
        </td>
        <td>
            <span class="label">Periode :</span>
            <t t-esc="periode"/>
        </td>
        <td>
            <span class="label">Date :</span>
            <t t-esc="date_declaration_str"/>
        </td>
    </tr>

    <!-- Ligne 2 -->
    <tr>
        <td colspan="3">
            <span class="label">Nom ou Raison sociale :</span>
            <t t-esc="company.name"/>
        </td>
    </tr>

    <!-- Ligne 3 -->
    <tr>
        <td>
            <span class="label">NINEA :</span>
            <t t-esc="ninea"/>
        </td>
        <td>
            <span class="label">Type Employeur :</span>
            <t t-esc="type_employeur"/>
        </td>
        <td></td>
    </tr>

    <!-- Ligne 4 -->
    <tr>
        <td colspan="3">
            <span class="label">Adresse :</span>
            <t t-esc="adresse_complete"/>
        </td>
    </tr>

</table>

<!-- ================= EFFECTIFS / SALAIRES ================= -->
<table>
<tr>
    <th>Lettre</th>
    <th>Effectifs</th>
    <th>Nbre</th>
    <th>Salaires</th>
    <th class="text-right">Montant</th>
</tr>

<tr>
    <td class="text-center"></td>
    <td>Effectif Global</td>
    <td class="text-center"><t t-esc="effectif_global"/></td>
    <td>Total salaires verses</td>
    <td class="text-right">
        <t t-esc="total_salaires"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <td class="text-center">A</td>
    <td>Salaries permanents ayant 63000 ou plus</td>
    <td class="text-center"><t t-esc="eff_perm_ge_63"/></td>
    <td>Salaires plafonnes</td>
    <td class="text-right">
        <t t-esc="sal_perm_ge_63"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <td class="text-center">B</td>
    <td>Salaries permanents ayant moins de 63000</td>
    <td class="text-center"><t t-esc="eff_perm_lt_63"/></td>
    <td>Salaires correspondants</td>
    <td class="text-right">
        <t t-esc="sal_perm_lt_63"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <td class="text-center">C</td>
    <td>Temporaires ou CDD ayant 63000 ou plus</td>
    <td class="text-center"><t t-esc="eff_cdd_ge_63"/></td>
    <td>Salaires plafonnes</td>
    <td class="text-right">
        <t t-esc="sal_cdd_ge_63"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <td class="text-center">D</td>
    <td>Temporaires ou CDD ayant moins de 63000</td>
    <td class="text-center"><t t-esc="eff_cdd_lt_63"/></td>
    <td>Remunerations verses</td>
    <td class="text-right">
        <t t-esc="sal_cdd_lt_63"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <td class="text-center">E</td>
    <td>Journaliers</td>
    <td class="text-center"><t t-esc="eff_journalier"/></td>
    <td>Remunerations verses</td>
    <td class="text-right">
        <t t-esc="sal_journalier"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <td class="text-center">F</td>
    <td>Apprentis et Stagiaires</td>
    <td class="text-center"><t t-esc="eff_apprenti"/></td>
    <td>Allocations verses</td>
    <td class="text-right">
        <t t-esc="alloc_apprenti"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>
</table>

<!-- ================= TOTAUX ================= -->
<table>
<tr>
    <th colspan="4">Total salaires assujettis PF (A+B+C+D+E)</th>
    <th class="text-right">
        <t t-esc="base_pf"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </th>
</tr>
<tr>
    <th colspan="4">Total salaires assujettis ATMP (A+B+C+D+E+F)</th>
    <th class="text-right">
        <t t-esc="base_atmp"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </th>
</tr>
</table>



<!-- ================= COTISATIONS ================= -->
<table>
<tr>
    <th>Branche</th>
    <th>Base</th>
    <th>Taux (%)</th>
    <th class="text-right">Montant</th>
</tr>

<tr>
    <td>Prestations familiales</td>
    <td class="text-right">
        <t t-esc="base_pf"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
    <td class="text-center"><t t-esc="taux_pf"/></td>
    <td class="text-right">
        <t t-esc="cot_pf"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <td>Accidents du travail</td>
    <td class="text-right">
        <t t-esc="base_atmp"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
    <td class="text-center"><t t-esc="taux_atmp"/></td>
    <td class="text-right">
        <t t-esc="cot_atmp"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </td>
</tr>

<tr>
    <th colspan="3">Total cotisations dues</th>
    <th class="text-right">
        <t t-esc="cot_total"
           t-options="{'widget':'monetary','display_currency':company.currency_id}"/>
    </th>
</tr>
</table>

</div>
</main>

<!-- ================= FOOTER ================= -->

    <div style="font-family:'Times New Roman', Times, serif; font-size:10px;">
        <img t-att-src="'/arsata_payroll/static/description/cssfooter.PNG'"
             class="img-full"/>
        <div style="text-align:right;">
            Page <span class="page"/> / <span class="topage"/>
        </div>
    </div>


</t>
</template>



















