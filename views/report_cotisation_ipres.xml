<template id="report_ipres_template">

        <t t-call="web.html_container">
        <t t-call="web.external_layout">

            <style>
                table.ipres_date {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 11px;
                }
                table.ipres {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 11px;
                }
                table.ipres th, table.ipres td {
                    border: 1px solid #000;
                    padding: 4px;
                }
                table.ipres th {
                    background: #f2f2f2;
                    text-align: center;
                    font-weight: bold;
                }
                .right { text-align: right; }
                .center { text-align: center; }
                .bold { font-weight: bold; }
            </style>

            <div class="page">

                <!-- ================= TITRE ================= -->
                <h3 class="center">DECLARATION DES COTISATIONS IPRES</h3>

                <!-- ================= INFOS ENTREPRISE ================= -->
                <table class="ipres_date" style="margin-bottom:8px;">
                    <tr>
                       
                        <td class="right">
                            <strong>Periode du :</strong>
                            <t t-esc="date_from"/> au <t t-esc="date_to"/>
                            <br/>
                            <strong>Date d'impression :</strong>
                            <t t-esc="print_date"/>
                        </td>
                    </tr>
                </table>

                <!-- ================= TABLEAU PRINCIPAL ================= -->
                <table class="ipres">
                    <thead>
                        <tr>
                            <th rowspan="2">NUM</th>
                            <th rowspan="2">Matricule</th>
                            <th rowspan="2">Nom Employe</th>
                            <th rowspan="2">Brut imposable</th>
                            <th colspan="3">IPRES Regime General</th>
                            <th colspan="3">IPRES Regime Cadre</th>
                            <th rowspan="2">Cotisation totale</th>
                        </tr>
                        <tr>
                            <th>Base</th>
                            <th>Employe</th>
                            <th>Employeur</th>
                            <th>Base</th>
                            <th>Employe</th>
                            <th>Employeur</th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- LIGNES EMPLOYES -->
                        <t t-foreach="rows" t-as="r">
                            <tr>
                                <td class="center"><t t-esc="r['num']"/></td>
                                <td><t t-esc="r['matricule']"/></td>
                                <td><t t-esc="r['nom']"/></td>

                                <td class="right"><t t-esc="r['brut']"/></td>

                                <td class="right"><t t-esc="r['rg_base']"/></td>
                                <td class="right"><t t-esc="r['rg_emp']"/></td>
                                <td class="right"><t t-esc="r['rg_pat']"/></td>

                                <td class="right"><t t-esc="r['rc_base']"/></td>
                                <td class="right"><t t-esc="r['rc_emp']"/></td>
                                <td class="right"><t t-esc="r['rc_pat']"/></td>

                                <td class="right bold"><t t-esc="r['total']"/></td>
                            </tr>
                        </t>

                        <!-- TOTAL GENERAL -->
                        <tr class="bold">
                            <td colspan="3" class="center">TOTAL GENERAL</td>

                            <td class="right"><t t-esc="totals['brut']"/></td>

                            <td class="right"><t t-esc="totals['rg_base']"/></td>
                            <td class="right"><t t-esc="totals['rg_emp']"/></td>
                            <td class="right"><t t-esc="totals['rg_pat']"/></td>

                            <td class="right"><t t-esc="totals['rc_base']"/></td>
                            <td class="right"><t t-esc="totals['rc_emp']"/></td>
                            <td class="right"><t t-esc="totals['rc_pat']"/></td>

                            <td class="right"><t t-esc="totals['total']"/></td>
                        </tr>
                    </tbody>
                </table>

            </div>

        </t>
        </t>

    </template>
    


