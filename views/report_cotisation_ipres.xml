    <record id="action_report_vrs" model="ir.actions.report">
    <field name="name">Etat VRS</field>
    <field name="model">cerco.payslip.lines.cotisation.ipres</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">arsata_payroll.report_vrs_template</field>
